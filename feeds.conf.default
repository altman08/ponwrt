# Track altman08 packages/luci on dev (not their default branch).
# Other feeds use their remote default branches: openwrt -> master;
# pbs05 and killadm -> main (verified when configured).
# ./scripts/feeds update -a pulls new commits; builds are not pinned to a commit.
src-git packages https://github.com/altman08/immortalwrt-packages.git;dev
src-git luci https://github.com/altman08/immortalwrt-luci.git;dev
src-git routing https://github.com/openwrt/routing.git
src-git telephony https://github.com/openwrt/telephony.git
src-git video https://github.com/openwrt/video.git
src-git pon_drivers https://github.com/pbs05/openwrt-pon-drivers.git
src-git pon_userspace https://github.com/pbs05/openwrt-pon-userspace.git
src-git qwe_luci_app https://github.com/qwe3017/luci-app.git
src-git luci_app_fakehttp https://github.com/killadm/luci-app-fakehttp.git
src-git luci_app_fakesip https://github.com/killadm/luci-app-fakesip.git
src-link shellinabox https://github.com/altman08/luci-app-shellinabox.git
#src-git targets https://github.com/openwrt/targets.git
#src-git oldpackages http://git.openwrt.org/packages.git
#src-link custom /usr/src/openwrt/custom-feed
