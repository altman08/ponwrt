#!/bin/sh

. /etc/openwrt_release

IEEE_PATH="/sys/class/ieee80211"
THERMAL_PATH="/sys/class/thermal"

case "$DISTRIB_TARGET" in
airoha/*)
	for sensor in "$IEEE_PATH"/phy*/device/hwmon/hwmon*/temp1_input \
		"$IEEE_PATH"/phy*/hwmon*/temp1_input; do
		[ -r "$sensor" ] || continue
		reading="$(awk '($1 ~ /^-?[0-9]+$/) { printf "%.1f°C", $1 / 1000 }' "$sensor")"
		[ -z "$reading" ] || wifi_temp="${wifi_temp:+$wifi_temp }$reading"
	done
	;;
ipq40xx/*|ipq806x/*)
	wifi_temp="$(awk '{printf("%.1f°C ", $0 / 1000)}' "$IEEE_PATH"/phy*/device/hwmon/hwmon*/temp1_input 2>"/dev/null" | awk '$1=$1')"
	;;
mediatek/mt7622)
	wifi_temp="$(awk '{printf("%.1f°C ", $0 / 1000)}' "$IEEE_PATH"/wl*/hwmon*/temp1_input 2>"/dev/null" | awk '$1=$1')"
	;;
*)
	wifi_temp="$(awk '{printf("%.1f°C ", $0 / 1000)}' "$IEEE_PATH"/phy*/hwmon*/temp1_input 2>"/dev/null" | awk '$1=$1')"
	;;
esac

case "$DISTRIB_TARGET" in
ipq40xx/*)
	if [ -e "$IEEE_PATH/phy0/hwmon0/temp1_input" ]; then
		mt76_temp="$(awk -F ': ' '{print $2}' "$IEEE_PATH/phy0/hwmon0/temp1_input" 2>"/dev/null")°C"
	fi
	[ -z "$mt76_temp" ] || wifi_temp="${wifi_temp:+$wifi_temp }$mt76_temp"
	;;
airoha/*)
	if [ -r "$THERMAL_PATH/thermal_zone0/temp" ]; then
		cpu_temp="$(awk '($1 ~ /^-?[0-9]+$/) { printf "%.1f°C", $1 / 1000 }' "$THERMAL_PATH/thermal_zone0/temp")"
	fi
	;;
*)
	cpu_temp="$(awk '{printf("%.1f°C", $0 / 1000)}' "$THERMAL_PATH/thermal_zone0/temp" 2>"/dev/null")"
	;;
esac

case "$DISTRIB_TARGET" in
airoha/*)
	if command -v ponctl >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
		pon_device="$(uci -q get 'pon.@xpon[0].device')"
		if [ -n "$pon_device" ]; then
			pon_temp="$(ponctl --device "$pon_device" status --json 2>/dev/null | jsonfilter -e '@.frontend.temperature_celsius' 2>/dev/null)"
			case "$pon_temp" in
			''|*[!0-9.-]*) pon_temp='' ;;
			*) pon_temp="$(awk -v temp="$pon_temp" 'BEGIN { printf "%.1f°C", temp }')" ;;
			esac
		fi
	fi
	;;
esac

readings=''
[ -z "$cpu_temp" ] || readings="CPU: $cpu_temp"
[ -z "$wifi_temp" ] || readings="${readings:+$readings, }WiFi: $wifi_temp"
[ -z "$pon_temp" ] || readings="${readings:+$readings, }PON: $pon_temp"
printf '%s\n' "${readings:-No temperature info}"
